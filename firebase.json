{
  "functions": [
    {
      "source": "./apps/functions",
      "predeploy": "yarn workspace functions build && yarn turbo prune functions && yarn workspace functions predeploy",
      "postdeploy": "yarn workspace functions postdeploy",
      "runtime": "nodejs24"
    }
  ],
  "hosting": {
    "source": "./apps/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "frameworksBackend": {
      "region": "asia-east1"
    }
  }
}

{
  "name": "easyboard-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "biome check --write",
    "format:check": "biome check",
    "app:prebuild": "yarn workspace app prebuild",
    "app:dev": "yarn workspace app dev",
    "app:android": "yarn workspace app android",
    "app:ios": "yarn workspace app ios",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "clean": "turbo clean && find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "yarn": "4.18.1"
  },
  "workspaces": [
    "runtimes/*"
  ],
  "packageManager": "yarn@4.18.1",
  "version": "1.0.0",
  "dependencies": {
    "@yarnpkg/types": "^4.0.1"
  },
  "resolutions": {
    "@react-native-firebase/app": "^23.5.0",
    "@react-native-firebase/auth": "^23.5.0",
    "@react-native-firebase/database": "^23.5.0",
    "@react-native-firebase/messaging": "^23.5.0",
    "firebase": "^12.19.0",
    "@types/react-native-web/react-native": "0.88.0-rc.3",
    "@nandorojo/iconic/react-native-svg": "15.15.5"
  }
}

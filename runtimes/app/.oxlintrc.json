{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "react"],
  "jsPlugins": ["eslint-plugin-expo"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "browser": true
  },
  "ignorePatterns": [
    "android/app/build",
    ".expo/**",
    "dist/**",
    "dist-*/**",
    "node_modules/**",
    "babel.config.js",
    "metro.config.js",
    "web-build/**",
    "android/**",
    "ios/**"
  ],
  "rules": {
    "import/namespace": "error",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-duplicates": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-dupe-class-members": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "warn",
    "no-empty-pattern": "warn",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-redeclare": "warn",
    "no-unreachable": "warn",
    "no-unsafe-negation": "warn",
    "no-unused-expressions": [
      "warn",
      {
        "allowShortCircuit": true,
        "enforceForJSX": true
      }
    ],
    "no-unused-labels": "warn",
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "none",
        "ignoreRestSiblings": true,
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-with": "warn",
    "unicode-bom": ["warn", "never"],
    "use-isnan": "error",
    "valid-typeof": "error",
    "import/first": "warn",
    "no-var": "error",
    "react/display-name": "error",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "warn",
    "react/no-this-in-sfc": "warn",
    "expo/use-dom-exports": ["error"],
    "expo/no-env-var-destructuring": ["error"],
    "expo/no-dynamic-env-var": ["error"],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/preserve-manual-memoization": "error",
    "react/incompatible-library": "warn",
    "react/immutability": "error",
    "react/globals": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/error-boundaries": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/unsupported-syntax": "warn"
  },
  "overrides": [
    {
      "files": ["**/metro.config.js"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "vars": "all",
            "args": "none",
            "ignoreRestSiblings": true,
            "caughtErrors": "all"
          }
        ],
        "no-useless-constructor": "warn",
        "typescript/array-type": [
          "warn",
          {
            "default": "array"
          }
        ],
        "typescript/no-empty-object-type": "warn",
        "typescript/no-wrapper-object-types": "warn",
        "typescript/consistent-type-assertions": [
          "warn",
          {
            "assertionStyle": "as",
            "objectLiteralTypeAssertions": "allow"
          }
        ],
        "typescript/no-extra-non-null-assertion": "warn",
        "typescript/no-require-imports": [
          "warn",
          {
            "allow": [
              "\\.(aac|aiff|avif|bmp|caf|db|gif|heic|html|jpeg|jpg|json|m4a|m4v|mov|mp3|mp4|mpeg|mpg|otf|pdf|png|psd|svg|ttf|wav|webm|webp|xml|yaml|yml|zip)$"
            ]
          }
        ]
      },
      "plugins": ["typescript"]
    },
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "import/namespace": "off",
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ],
        "react/set-state-in-effect": "warn",
        "react/immutability": "warn",
        "react/use-memo": "warn",
        "react/preserve-manual-memoization": "warn",
        "react/refs": "warn",
        "typescript/no-explicit-any": "warn",
        "typescript/no-require-imports": "warn",
        "typescript/consistent-type-imports": [
          "warn",
          {
            "prefer": "type-imports",
            "fixStyle": "inline-type-imports"
          }
        ]
      },
      "env": {
        "es2024": true,
        "browser": true
      },
      "plugins": ["typescript"]
    },
    {
      "files": ["**/*.js"],
      "env": {
        "node": true
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.3.0"
    }
  }
}
